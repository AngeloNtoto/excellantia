// Excellantia - Schéma Prisma
// Base de données orientée contenu + salles + timing.
// Les salles utilisent 2 modes principaux : TRAINING et SIMULATION.
// Le mode "salon" est géré comme un cas de simulation avec possibilité d'ajouter des questions d'entraînement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CANDIDATE
}

enum Subject {
  MATH
  FRENCH
  ENGLISH
  GENERAL_CULTURE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  FR
  EN
}

enum RoomMode {
  TRAINING
  SIMULATION
}

enum RoomStatus {
  WAITING
  SCHEDULED
  RUNNING
  CLOSED
  CANCELLED
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

// Régime Temporel — comment le temps s'écoule dans la salle
enum TimingRegime {
  EINSTEIN    // Le Continuum : temps global fluide, navigation libre entre matières
  NEWTON      // La Mécanique : temps segmenté par matière, phase par phase
  TESLA       // L'Éclair : 1 question = 1 minute, aucun retour possible
}

// Mode d'Horloge — quand le chronomètre commence
enum ClockMode {
  ABSOLUTE    // Tout le monde commence et finit en même temps (startsAt → endsAt)
  RELATIVE    // Chacun son chrono individuel (démarre au clic, durée = durationMin)
}

enum QuestionType {
  MULTIPLE_CHOICE
  PASSAGE_BASED
}

enum QuestionSource {
  USER_CREATED
  ROOM_GENERATED
  TRAINING_POOL
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED_TIME_EXPIRED
  AUTO_SUBMITTED_DISCONNECTED
}

enum AttemptLockReason {
  NONE
  TIME_EXPIRED
}

model User {
  id        String   @id @default(cuid())
  fullname  String
  code      String   @unique
  role      Role     @default(CANDIDATE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts       Attempt[]
  roomAccess     RoomAccess[]
  createdRooms   Room[]
  createdTexts   TextContent[]
  createdQuestions Question[]
}

model TextContent {
  id        String   @id @default(cuid())
  title     String
  language  Language @default(FR)
  content   String
  source    String?
  isActive  Boolean  @default(true)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id])
  questions Question[]
}

model Question {
  id            String        @id @default(cuid())
  textContentId String?
  subject       Subject
  topic         String?
  subtopic      String?
  difficulty    Difficulty
  language      Language      @default(FR)
  statement     String
  options       Json
  answerIndex   Int
  explanation   String?
  optionExplanations Json?
  passageId     String?
  scope         String?
  type          QuestionType  @default(MULTIPLE_CHOICE)
  source        QuestionSource @default(USER_CREATED)
  mode          RoomMode?
  createdById   String?
  timesAppeared Int           @default(0) // Nombre de fois tirée dans une épreuve ou entraînement
  timesAnswered Int           @default(0) // Nombre de fois où un candidat y a répondu
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  textContent TextContent? @relation(fields: [textContentId], references: [id])
  createdBy   User? @relation(fields: [createdById], references: [id])
}

model Room {
  id                       String         @id @default(cuid())
  title                    String
  status                   RoomStatus     @default(WAITING)
  visibility               RoomVisibility @default(PUBLIC)
  mode                     RoomMode       @default(SIMULATION)
  includeTrainingQuestions Boolean        @default(false)
  accessCode               String?
  timingRegime             TimingRegime   @default(EINSTEIN)  // Régime temporel de la salle
  clockMode                ClockMode      @default(ABSOLUTE)  // Mode d'horloge
  schrodingerMode          Boolean        @default(false)     // 🐱 Chrono caché si true
  durationMin              Int            @default(100)
  startsAt                 DateTime?
  endsAt                   DateTime?
  questionIds              Json?          // IDs des questions tirées pour cette salle
  config                   Json?          // Config de génération (répartition, difficulté, etc.)
  timingConfig             Json?          // Config de timing par matière (Newton) ou par question (Tesla)
  createdById              String
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  createdBy  User        @relation(fields: [createdById], references: [id])
  attempts   Attempt[]
  roomAccess RoomAccess[]
}

model Attempt {
  id              String            @id @default(cuid())
  userId          String
  roomId          String
  startedAt       DateTime          @default(now())
  submittedAt     DateTime?
  status          AttemptStatus     @default(IN_PROGRESS)
  score           Int?
  percentage      Float?
  scoreBySubject  Json?
  timeUsedSec     Int?
  isLocked        Boolean           @default(false)
  lockReason      AttemptLockReason @default(NONE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  room    Room     @relation(fields: [roomId], references: [id])
  answers Answer[]
}

model Answer {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  selectedIndex Int?
  flagged       Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  attempt Attempt @relation(fields: [attemptId], references: [id])

  @@unique([attemptId, questionId])
}

model RoomAccess {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  grantedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
}
